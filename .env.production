# ---------------------------------------------------------------------------
# Nawi — variables de PRODUCCIÓN (las usa `npm run build` / `npm run preview`)
#
# Este archivo SÍ se versiona a propósito: .env.local no se versiona ni lo lee
# la CI, así que sin esto el build saldría en modo `mock` (datos de
# demostración) y publicado no mostraría observaciones reales.
#
# Para desplegar en un servidor público, sobreescribí VITE_API_BASE con la URL
# real del backend, por ejemplo:
#   VITE_API_BASE=https://api.nawi.example npm run build
# o creá un .env.production.local (ignorado por git) con ese valor.
# ---------------------------------------------------------------------------

# Fuente de datos del catálogo: api = backend real.
VITE_NAWI_DATA_SOURCE=api

# Base del backend, sin barra final. Se usa para las llamadas a la API y para
# resolver las URLs relativas de los cuadros (/media/<slug>/frames/NNNN.png).
# 127.0.0.1:8010 es la demo local; en un deploy público tiene que apuntar al
# backend real (el backend habilita CORS solo para los orígenes de desarrollo).
VITE_API_BASE=http://127.0.0.1:8010
