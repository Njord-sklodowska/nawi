# ---------------------------------------------------------------------------
# Nawi — variables de entorno del frontend (Vite)
#
# Copiá este archivo a .env.local y ajustá los valores.
# Vite solo expone al código las variables que empiezan con VITE_.
# .env.local está en .gitignore: no se versiona.
# ---------------------------------------------------------------------------

# Fuente de datos del catálogo.
#   mock -> datos de demostración incluidos en el repo (POR DEFECTO)
#   api  -> backend Django real (GET /api/objetos/ y /api/objetos/<slug>/)
VITE_NAWI_DATA_SOURCE=mock

# Base del backend Django, sin barra final.
# Se usa para todas las llamadas a la API y para resolver las URLs relativas de
# los cuadros (por ejemplo /media/barnard/frames/0000.png).
# En desarrollo, el backend corre con:
#   cd backend && ./.venv/bin/python manage.py runserver 8010
VITE_API_BASE=http://127.0.0.1:8010
